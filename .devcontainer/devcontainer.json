{
  "name": "Auanema rhodense R Analysis",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash",
        "r.rterm.linux": "/usr/local/bin/R",
        "r.sessionWatcher.enabled": true,
        "r.rterm.option": [
          "--no-save",
          "--no-restore"
        ]
      },
      "extensions": [
        "REditorSupport.r",
        "REditorSupport.r-lsp",
        "Ikuyadeu.r",
        "REditorSupport.r-debugger"
      ]
    }
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/renv-cache:latest": {}
  },
  "containerEnv": {
    "RENV_PATHS_CACHE": "/tmp/renv-cache"
  },
  "postCreateCommand": "R -e \"if (!requireNamespace('languageserver', quietly = TRUE)) install.packages('languageserver')\""
}
